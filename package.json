{
  "name": "@jclong98/goose",
  "version": "0.0.6",
  "private": false,
  "description": "Core Vue components, composables, directives, and styles for Goose",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/goose.js"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./composables": {
      "types": "./dist/types/composables/index.d.ts",
      "import": "./dist/composables.js"
    },
    "./directives": {
      "types": "./dist/types/directives/index.d.ts",
      "import": "./dist/directives.js"
    },
    "./integrations": {
      "types": "./dist/types/integrations/index.d.ts",
      "import": "./dist/integrations.js"
    },
    "./style.css": "./dist/goose.css",
    "./tw-theme.css": "./dist/tw-theme.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "build-only": "vp build --mode lib",
    "type-check": "vue-tsc --build",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "vp lint --type-aware",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.5.0",
    "@vitejs/devtools": "0.1.11",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/browser-webdriverio": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.2.1",
    "defu": "^6.1.4",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "oxc-minify": "^0.154.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "tinyglobby": "^0.2.15",
    "typescript": "~6.0.2",
    "unimport": "^6.0.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vite-plus": "catalog:",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "catalog:",
    "vitest-browser-vue": "^2.1.0",
    "vue-component-meta": "^3.2.6",
    "vue-router": "^5.0.4",
    "vue-tsc": "^3.2.6",
    "webdriverio": "*"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.2.1",
    "unimport": "^6.0.2",
    "vue": "^3.5.31"
  },
  "peerDependenciesMeta": {
    "@vueuse/core": {
      "optional": true
    }
  }
}
